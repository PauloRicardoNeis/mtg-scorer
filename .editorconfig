# Editors and IDEs read this; .gitattributes enforces the same line endings in git.
# Every text file is LF, UTF-8, with a final newline; only Windows command scripts
# keep CRLF.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.{py,pyi}]
indent_size = 4

[*.java]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf

[analytics/seeds/**]
# Retained source payloads are identified by their exact bytes.
insert_final_newline = false
trim_trailing_whitespace = false
