  "components": {
    "schemas": {
      "CardSummary": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "oracle_id",
          "name",
          "layout",
          "color_identity",
          "eligible_printing_count"
        ],
        "properties": {
          "oracle_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "layout": {
            "type": "string"
          },
          "color_identity": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "enum": [
                "W",
                "U",
                "B",
                "R",
                "G"
              ]
            }
          },
          "eligible_printing_count": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "CardPage": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "catalog_snapshot_id",
          "items",
          "next_cursor"
        ],
        "properties": {
          "catalog_snapshot_id": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CardSummary"
            }
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
