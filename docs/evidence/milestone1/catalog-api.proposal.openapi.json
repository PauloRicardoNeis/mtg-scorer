          "name",
          "layout",
          "mana_cost",
          "mana_value",
          "oracle_text",
          "type_line",
          "colors",
          "color_identity",
          "faces"
        ],
        "properties": {
          "catalog_snapshot_id": {
            "type": "string"
          },
          "oracle_id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "layout": {
            "type": "string"
          },
          "mana_cost": {
            "type": [
              "string",
              "null"
            ]
          },
          "mana_value": {
            "type": [
              "number",
              "null"
            ],
            "minimum": 0
          },
          "oracle_text": {
            "type": [
              "string",
              "null"
            ]
          },
          "type_line": {
            "type": [
              "string",
              "null"
            ]
          },
          "colors": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "color_identity": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "type": "string"
            }
          },
          "faces": {
            "type": "array",
