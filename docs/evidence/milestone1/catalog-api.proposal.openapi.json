{
  "openapi": "3.1.0",
  "info": {
    "title": "MTG Scorer proposed catalog API",
    "version": "1.0.0-draft",
    "description": "Design contract only. Current server implements info/health/OpenAPI, not these paths. Replace this proposal with generated Spring OpenAPI as endpoints ship; verify operation semantics against this contract."
  },
  "paths": {
    "/api/v1/cards": {
      "get": {
        "operationId": "searchCards",
        "summary": "Search catalog; no scores or tournament ordering",
        "parameters": [
          {
            "name": "catalog_snapshot_id",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^[a-z0-9][a-z0-9-]{0,95}$"
            },
            "description": "Omit on first request to resolve active once; provide to pin. Cursor embeds it; conflicting explicit ID is 400."
          },
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 100
            },
            "description": "Literal substring of canonical/face aliases after name-key normalization; trim blank to absent. No query language or wildcard semantics."
          },
          {
            "name": "set",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[a-z0-9]{2,8}$"
              },
              "maxItems": 32
            },
            "description": "Repeated parameters, OR within this filter; unknown valid code returns empty.",
            "style": "form",
            "explode": true
          },
          {
            "name": "rarity",
            "in": "query",
            "required": false,
            "schema": {
              "type": "array",
              "items": {
                "enum": [
                  "common",
                  "uncommon",
                  "rare",
                  "mythic",
                  "special",
                  "bonus"
                ]
              },
              "maxItems": 6
            },
            "description": "Repeated values, OR within this filter.",
            "style": "form",
            "explode": true
          },
          {
            "name": "game",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "paper",
                "arena",
                "mtgo"
              ]
            },
            "description": "Printing game membership; omitted means any game."
          },
          {
            "name": "color_identity",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "pattern": "^(C|[WUBRG]{1,5})$"
            },
            "description": "Identity contained within selected colors, including colorless. C means exactly colorless. Reject duplicates; unknown identity never matches."
          },
          {
            "name": "sort",
            "in": "query",
            "required": false,
            "schema": {
              "enum": [
                "name_asc"
              ],
              "default": "name_asc"
            },
            "description": "Order by name_key COLLATE C then oracle_id UUID."
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 24
            },
            "description": "Maximum items; bound to cursor identity."
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 4096
            },
            "description": "Opaque versioned base64url cursor; includes snapshot, sort, filter hash, limit and last key. Repeat original filters."
          }
        ],
        "responses": {
          "200": {
            "description": "Success, pinned to one published catalog",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CardPage"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "404": {
            "description": "Published snapshot or resource not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "503": {
            "description": "No valid active catalog / serving database unavailable",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected failure",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    },
