                "label",
                "url"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "url": {
                  "type": "string",
                  "format": "uri"
                }
              }
            }
          },
          "tournament_evidence": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "reason_codes"
            ],
            "properties": {
              "state": {
                "const": "not_available"
              },
              "reason_codes": {
                "type": "array",
                "items": {
                  "const": "no_tournament_dataset"
                },
                "minItems": 1,
                "maxItems": 1
              }
            }
          },
          "retrieved_from": {
            "type": "string",
            "format": "date-time"
          },
          "retrieved_to": {
            "type": "string",
            "format": "date-time"
          },
          "excluded_record_counts": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      },
      "SnapshotList": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "active_catalog_snapshot_id",
          "items"
        ],
        "properties": {
          "active_catalog_snapshot_id": {
            "type": "string"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Snapshot"
            }
          }
        }
      },
      "Problem": {
        "type": "object",
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance",
          "code"
        ],
        "properties": {
          "type": {
            "type": "string",
            "format": "uri"
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          },
          "code": {
            "enum": [
              "invalid_query",
              "invalid_cursor",
              "snapshot_not_found",
              "card_not_found",
              "catalog_unavailable",
              "internal_error"
            ]
          }
        },
        "additionalProperties": true
      }
    }
  }
}
