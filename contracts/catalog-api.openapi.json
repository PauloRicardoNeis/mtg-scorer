  "info": {
    "description": "Guest catalog and immutable snapshot queries over Python-published data. No tournament evidence or scores.",
    "title": "MTG Scorer API",
    "version": "0.1.0-SNAPSHOT"
  },
  "openapi": "3.1.0",
  "paths": {
    "/actuator/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              },
              "application/vnd.spring-boot.actuator.v2+json": {
                "schema": {
                  "type": "object"
                }
              },
              "application/vnd.spring-boot.actuator.v3+json": {
                "schema": {
                  "type": "object"
                }
              }
            },
            "description": "OK"
          }
        },
        "summary": "Actuator web endpoint 'health'",
        "tags": [
          "Actuator"
        ]
      }
    },
    "/api/v1/cards": {
      "get": {
        "operationId": "searchCards",
        "parameters": [
          {
            "in": "query",
            "name": "catalog_snapshot_id",
            "required": false,
            "schema": {
              "pattern": "^[a-z0-9][a-z0-9-]{0,95}$",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "color_identity",
            "required": false,
            "schema": {
              "pattern": "^(C|[WUBRG]{1,5})$",
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "cursor",
            "required": false,
            "schema": {
              "maxLength": 4096,
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "game",
            "required": false,
            "schema": {
              "enum": [
                "arena",
                "mtgo",
                "paper"
              ],
              "type": "string"
            }
          },
          {
            "in": "query",
            "name": "limit",
            "required": false,
            "schema": {
              "default": 24,
              "format": "int32",
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "in": "query",
            "name": "q",
            "required": false,
            "schema": {
              "maxLength": 100,
              "type": "string"
            }
          },
          {
            "explode": true,
            "in": "query",
            "name": "rarity",
            "required": false,
            "schema": {
              "items": {
                "enum": [
                  "bonus",
                  "common",
                  "mythic",
                  "rare",
                  "special",
                  "uncommon"
                ],
                "type": "string"
              },
              "maxItems": 6,
              "type": "array"
            },
            "style": "form"
          },
          {
            "explode": true,
            "in": "query",
            "name": "set",
            "required": false,
            "schema": {
              "items": {
                "pattern": "^[a-z0-9]{2,8}$",
                "type": "string"
              },
              "maxItems": 32,
              "type": "array"
            },
            "style": "form"
          },
          {
            "in": "query",
            "name": "sort",
            "required": false,
            "schema": {
              "default": "name_asc",
              "enum": [
                "name_asc"
              ],
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CardPage"
                }
              }
            },
            "description": "OK"
          },
          "400": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogError"
                }
              }
            },
            "description": "Sanitized Problem Details with a stable code"
          },
          "404": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogError"
                }
              }
            },
            "description": "Sanitized Problem Details with a stable code"
          },
          "500": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogError"
                }
              }
            },
            "description": "Sanitized Problem Details with a stable code"
          },
          "503": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogError"
                }
              }
            },
            "description": "Sanitized Problem Details with a stable code"
          }
        },
        "summary": "Search names and faces within a jointly eligible printing pool",
        "tags": [
          "catalog-controller"
        ]
      }
    },
