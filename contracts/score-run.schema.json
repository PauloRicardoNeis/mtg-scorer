{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Score-run file v2",
  "description": "One cohort's card usage and every score method's results, as written by mtg-scorer score-topdeck.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "score_run_id",
    "dataset_snapshot_id",
    "parser_version",
    "feature_pipeline_version",
    "cohort_rules_hash",
    "population_rule",
    "method_identities",
    "source",
    "attribution",
    "raw_files",
    "cohort",
    "population",
    "cards",
    "runs"
  ],
  "properties": {
    "schema_version": { "const": "score-run-file-v2" },
    "score_run_id": { "type": "string", "pattern": "^scores-[0-9a-f]{64}$" },
    "dataset_snapshot_id": { "$ref": "#/$defs/text" },
    "parser_version": { "$ref": "#/$defs/text" },
    "feature_pipeline_version": { "$ref": "#/$defs/text" },
    "cohort_rules_hash": { "$ref": "#/$defs/sha256" },
    "population_rule": { "$ref": "#/$defs/text" },
    "method_identities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "array",
        "prefixItems": [
          { "$ref": "#/$defs/method_id" },
          { "$ref": "#/$defs/text" },
          { "$ref": "#/$defs/sha256" }
        ],
        "items": false,
        "minItems": 3
      }
    },
    "source": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "attribution": { "$ref": "#/$defs/text" },
    "raw_files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "sha256", "bytes", "retrieved_at", "retrieved_at_basis"],
        "properties": {
          "name": { "$ref": "#/$defs/text" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "bytes": { "type": "integer", "minimum": 0 },
          "retrieved_at": { "type": "string", "format": "date-time" },
          "retrieved_at_basis": { "enum": ["manifest", "file_mtime"] }
        }
      }
    },
    "cohort": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rules",
        "events",
        "excluded_events",
        "totals",
        "performance",
        "series",
        "archetypes"
      ],
      "properties": {
        "rules": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "version",
            "format_name",
            "starts_on",
            "ends_before",
            "min_decklist_coverage",
            "players_per_game",
            "excluded_events",
            "hash"
          ],
          "properties": {
            "version": { "$ref": "#/$defs/text" },
            "format_name": { "$ref": "#/$defs/text" },
            "starts_on": { "type": "string", "format": "date" },
            "ends_before": { "type": "string", "format": "date" },
            "min_decklist_coverage": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "players_per_game": { "type": "integer", "minimum": 2 },
            "excluded_events": { "type": "array", "items": { "$ref": "#/$defs/excluded_event" } },
            "hash": { "$ref": "#/$defs/sha256" }
          }
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "source_event_id",
              "occurred_on",
              "players",
              "decklists",
              "top_cut_size",
              "top_cut_basis"
            ],
            "properties": {
              "source_event_id": { "$ref": "#/$defs/text" },
              "name": {
                "description": "The event as its source names it; from parser topdeck-bulk-v4 on.",
                "anyOf": [{ "$ref": "#/$defs/text" }, { "type": "null" }]
              },
              "url": {
                "description": "The source's page for the event.",
                "anyOf": [{ "type": "string", "pattern": "^https://\\S+$" }, { "type": "null" }]
              },
              "occurred_on": { "type": "string", "format": "date" },
              "players": { "type": ["integer", "null"], "minimum": 1 },
              "decklists": { "type": ["integer", "null"], "minimum": 0 },
              "top_cut_size": { "type": ["integer", "null"], "minimum": 0 },
              "top_cut_basis": {
                "enum": [
                  "bracket_record",
                  "standing_order",
                  "inconsistent_order",
                  "no_top_cut",
                  "unknown_top_cut"
                ]
              }
            }
          }
        },
        "excluded_events": { "type": "array", "items": { "$ref": "#/$defs/excluded_event" } },
        "totals": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "events",
            "players",
            "decks",
            "incomplete_decks_excluded",
            "top_cut_players",
            "top_cut_decks",
            "quarantined_card_lines_in_source",
            "top_cut_known_decks",
            "record_decks",
            "matches"
          ],
          "properties": {
            "events": { "$ref": "#/$defs/count" },
            "players": { "$ref": "#/$defs/count" },
            "decks": { "$ref": "#/$defs/count" },
            "incomplete_decks_excluded": { "$ref": "#/$defs/count" },
            "top_cut_players": { "$ref": "#/$defs/count" },
            "top_cut_decks": { "$ref": "#/$defs/count" },
            "quarantined_card_lines_in_source": { "$ref": "#/$defs/count" },
            "team_events_skipped_in_source": { "$ref": "#/$defs/count" },
            "top_cut_known_decks": { "$ref": "#/$defs/count" },
            "record_decks": { "$ref": "#/$defs/count" },
            "matches": { "$ref": "#/$defs/count" }
          }
        },
        "performance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["players_per_game", "record", "win_rate", "top_cut_rate"],
          "properties": {
            "players_per_game": { "type": "integer", "minimum": 2 },
            "record": { "$ref": "#/$defs/record" },
            "win_rate": { "$ref": "#/$defs/fraction" },
            "top_cut_rate": { "$ref": "#/$defs/fraction" }
          }
        },
        "series": {
          "description": "Decks per trend period, oldest first; periods end where the cohort window ends.",
          "type": "object",
          "additionalProperties": false,
          "required": ["starts_on", "period_days", "decks"],
          "properties": {
            "starts_on": { "type": "string", "format": "date" },
            "period_days": { "type": "integer", "minimum": 1 },
            "decks": { "$ref": "#/$defs/series" }
          }
        },
        "archetypes": {
          "description": "Each archetype label with the cards at least half of its decks play. From feature pipeline card-usage-v5 on, it also carries its commanders and its decks' events, top cuts, record, performance and trend, as a card does.",
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "deck_count", "core_cards"],
            "dependentRequired": {
              "record": [
                "commanders",
                "event_count",
                "top_cut_count",
                "top_cut_known_decks",
                "performance",
                "series"
              ]
            },
            "properties": {
              "label": { "$ref": "#/$defs/text" },
              "deck_count": { "type": "integer", "minimum": 1 },
              "core_cards": {
                "type": "array",
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/oracle_id" }
              },
              "commanders": {
                "description": "The commanders that name the archetype, in label order; empty for a source's label.",
                "type": "array",
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/oracle_id" }
              },
              "event_count": { "type": "integer", "minimum": 1 },
              "top_cut_count": { "type": ["integer", "null"], "minimum": 0 },
              "top_cut_known_decks": { "$ref": "#/$defs/count" },
              "record": { "$ref": "#/$defs/record" },
              "performance": { "$ref": "#/$defs/performance" },
              "series": { "$ref": "#/$defs/series" }
            }
          }
        }
      }
    },
    "population": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "scored_cards", "excluded_cards"],
      "properties": {
        "rule": { "$ref": "#/$defs/text" },
        "scored_cards": { "$ref": "#/$defs/count" },
        "excluded_cards": { "type": "array", "items": { "$ref": "#/$defs/text" } }
      }
    },
    "cards": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "oracle_id",
          "name",
          "scored",
          "deck_count",
          "event_count",
          "top_cut_count",
          "top_cut_known_decks",
          "archetype",
          "archetypes",
          "mainboard_copies",
          "record",
          "performance",
          "series"
        ],
        "properties": {
          "oracle_id": { "$ref": "#/$defs/oracle_id" },
          "name": { "$ref": "#/$defs/text" },
          "scored": { "type": "boolean" },
          "deck_count": { "type": "integer", "minimum": 1 },
          "event_count": { "type": "integer", "minimum": 1 },
          "top_cut_count": { "type": ["integer", "null"], "minimum": 0 },
          "top_cut_known_decks": { "$ref": "#/$defs/count" },
          "archetype": {
            "type": "object",
            "additionalProperties": false,
            "required": ["label", "deck_count", "labelled_deck_count"],
            "properties": {
              "label": { "anyOf": [{ "$ref": "#/$defs/text" }, { "type": "null" }] },
              "deck_count": { "$ref": "#/$defs/count" },
              "labelled_deck_count": { "$ref": "#/$defs/count" }
            }
          },
          "archetypes": {
            "type": "object",
            "additionalProperties": false,
            "required": ["distinct", "top"],
            "properties": {
              "distinct": { "$ref": "#/$defs/count" },
              "top": {
                "type": "array",
                "maxItems": 3,
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["label", "deck_count"],
                  "properties": {
                    "label": { "$ref": "#/$defs/text" },
                    "deck_count": { "type": "integer", "minimum": 1 }
                  }
                }
              }
            }
          },
          "mainboard_copies": { "type": "integer", "minimum": 1 },
          "record": { "$ref": "#/$defs/record" },
          "performance": { "$ref": "#/$defs/performance" },
          "series": { "$ref": "#/$defs/series" },
          "decks": {
            "description": "The card's decks by their position in the run's decks, ascending; from feature pipeline card-usage-v7 on.",
            "type": "array",
            "items": { "$ref": "#/$defs/count" }
          },
          "deck_copies": {
            "description": "The mainboard copies each of the card's decks plays, in the order of decks.",
            "type": "array",
            "items": { "type": "integer", "minimum": 1 }
          }
        },
        "dependentRequired": { "decks": ["deck_copies"], "deck_copies": ["decks"] }
      }
    },
    "decks": {
      "description": "The cohort's decks, newest event first; from feature pipeline card-usage-v7 on. A deck's result is what its standing reported, null when unknown.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "source_deck_id",
          "source_event_id",
          "archetype",
          "final_rank",
          "made_top_cut",
          "record"
        ],
        "dependentRequired": { "commanders": ["sideboard"], "sideboard": ["commanders"] },
        "properties": {
          "source_deck_id": { "$ref": "#/$defs/text" },
          "source_event_id": { "$ref": "#/$defs/text" },
          "archetype": { "anyOf": [{ "$ref": "#/$defs/text" }, { "type": "null" }] },
          "final_rank": { "type": ["integer", "null"], "minimum": 1 },
          "made_top_cut": { "type": ["boolean", "null"] },
          "commanders": {
            "description": "The cards the source listed as the deck's commanders, by oracle id; from feature pipeline card-usage-v8 on.",
            "type": "array",
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/oracle_id" }
          },
          "sideboard": {
            "description": "The sideboard the source reported, by oracle id; null when it reported none or not all of it. From feature pipeline card-usage-v8 on.",
            "anyOf": [
              {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["oracle_id", "name", "copies"],
                  "properties": {
                    "oracle_id": { "$ref": "#/$defs/oracle_id" },
                    "name": { "$ref": "#/$defs/text" },
                    "copies": { "type": "integer", "minimum": 1 }
                  }
                }
              },
              { "type": "null" }
            ]
          },
          "record": {
            "anyOf": [
              {
                "type": "object",
                "additionalProperties": false,
                "required": ["wins", "losses", "draws"],
                "properties": {
                  "wins": { "$ref": "#/$defs/count" },
                  "losses": { "$ref": "#/$defs/count" },
                  "draws": { "$ref": "#/$defs/count" }
                }
              },
              { "type": "null" }
            ]
          }
        }
      }
    },
    "runs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "method_id",
          "method_version",
          "method_config_hash",
          "label",
          "description",
          "outputs",
          "scores"
        ],
        "properties": {
          "method_id": { "$ref": "#/$defs/method_id" },
          "method_version": { "$ref": "#/$defs/text" },
          "method_config_hash": { "$ref": "#/$defs/sha256" },
          "label": { "$ref": "#/$defs/text" },
          "description": { "$ref": "#/$defs/text" },
          "outputs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "$ref": "#/$defs/text" }
          },
          "scores": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["card_id", "values", "inputs"],
              "properties": {
                "card_id": { "$ref": "#/$defs/oracle_id" },
                "values": { "$ref": "#/$defs/named_numbers" },
                "inputs": { "$ref": "#/$defs/named_numbers" }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "text": { "type": "string", "minLength": 1, "pattern": "\\S" },
    "count": { "type": "integer", "minimum": 0 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "method_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
    "oracle_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "named_numbers": {
      "type": "object",
      "propertyNames": { "minLength": 1 },
      "additionalProperties": { "type": ["number", "null"] }
    },
    "excluded_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_event_id", "reason"],
      "properties": {
        "source_event_id": { "$ref": "#/$defs/text" },
        "reason": { "$ref": "#/$defs/text" }
      }
    },
    "fraction": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "series": {
      "type": "array",
      "minItems": 12,
      "maxItems": 12,
      "items": { "$ref": "#/$defs/count" }
    },
    "record": {
      "type": "object",
      "additionalProperties": false,
      "required": ["decks", "wins", "losses", "draws"],
      "properties": {
        "decks": { "$ref": "#/$defs/count" },
        "wins": { "$ref": "#/$defs/count" },
        "losses": { "$ref": "#/$defs/count" },
        "draws": { "$ref": "#/$defs/count" }
      }
    },
    "performance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["win_rate", "win_rate_delta", "win_rate_ci95", "top_cut_lift", "share_delta"],
      "properties": {
        "win_rate": { "$ref": "#/$defs/fraction" },
        "win_rate_delta": { "type": ["number", "null"], "minimum": -1, "maximum": 1 },
        "win_rate_ci95": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
        "top_cut_lift": { "type": ["number", "null"], "minimum": 0 },
        "share_delta": { "type": ["number", "null"], "minimum": -1, "maximum": 1 }
      }
    }
  }
}
