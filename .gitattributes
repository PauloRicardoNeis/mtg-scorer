# Every text file is stored and checked out with LF, on every platform, so Prettier,
# Spotless and Ruff see the same bytes everywhere. .editorconfig says the same to editors.
* text=auto eol=lf

# Windows command scripts need CRLF to run.
*.cmd text eol=crlf
*.bat text eol=crlf

# These source payloads and manifests are identified by their exact byte hashes.
analytics/seeds/scryfall-layouts-v1/*.json -text
analytics/tests/fixtures/** -text
