{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Mutation testing with Stryker over the vitest suite; weekly in CI, `npm run mutation` locally. Message files are data and api.generated.ts is generated, so neither is mutated. Reports land in reports/mutation; reports/stryker-incremental.json keeps the incremental state.",
  "testRunner": "vitest",
  "vitest": { "configFile": "vitest.config.ts" },
  "mutate": [
    "src/lib/**/*.ts",
    "src/components/**/*.{ts,tsx}",
    "src/i18n/**/*.{ts,tsx}",
    "!src/**/*.test.{ts,tsx}",
    "!src/lib/api.generated.ts",
    "!src/i18n/messages/*.ts",
    "!src/i18n/types.ts"
  ],
  "coverageAnalysis": "perTest",
  "ignoreStatic": true,
  "incremental": true,
  "incrementalFile": "reports/stryker-incremental.json",
  "reporters": ["html", "json", "clear-text", "progress"],
  "htmlReporter": { "fileName": "reports/mutation/mutation.html" },
  "jsonReporter": { "fileName": "reports/mutation/mutation.json" },
  "thresholds": { "high": 90, "low": 80, "break": null },
  "tempDirName": ".stryker-tmp",
  "cleanTempDir": true
}
